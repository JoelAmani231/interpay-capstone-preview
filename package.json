{
  "name": "interpay-capstone-preview",
  "version": "2.1.0-preview",
  "description": "InterPay - mobile money transfer simulator (preview build, national transfers)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "concurrently -n gateway,moov,orange,mtn,wave,web \"npm run gateway\" \"npm run moov\" \"npm run orange\" \"npm run mtn\" \"npm run wave\" \"npm run web\"",
    "gateway": "node Gateway/server.js",
    "moov": "node Operators/moov/server.js",
    "orange": "node Operators/orange/server.js",
    "mtn": "node Operators/mtn/server.js",
    "wave": "node Operators/wave/server.js",
    "web": "node scripts/serveFrontend.js",
    "setup": "node scripts/setupDB.js",
    "seed": "node scripts/seedAll.js",
    "reset": "node scripts/setupDB.js --reset",
    "selftest": "node scripts/selfTest.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.3",
    "node-fetch": "^2.7.0"
  }
}
