# InterPay preview build — default configuration.
# `npm run setup` copies this file to `.env` automatically if `.env` does not exist.
# You only need to edit .env if your MySQL root user has a password.

# ── Database (XAMPP default: user "root", empty password) ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=interpay_preview

# ── Ports ──
GATEWAY_PORT=5000
MOOV_PORT=5001
ORANGE_PORT=5002
MTN_PORT=5003
WAVE_PORT=5004
FRONTEND_PORT=5050

# ── Demo secrets (shared by the Gateway and the operator servers) ──
JWT_SECRET=interpay_demo_jwt_secret
INTERNAL_SECRET=interpay_demo_internal_secret

# ── Operator URLs (Gateway -> operator servers, all on this machine) ──
MOOV_URL=http://localhost:5001
ORANGE_URL=http://localhost:5002
MTN_URL=http://localhost:5003
WAVE_URL=http://localhost:5004

# ── Rate limits (requests per 15 min per client) ──
# Raised so a reviewer clicking around is never locked out.
RATE_LIMIT_MAX=2000
LOGIN_RATE_LIMIT_MAX=200
OPERATOR_RATE_LIMIT_MAX=5000
